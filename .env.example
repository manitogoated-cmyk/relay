# Copy to .env (repo root) and adjust. Every setting is RELAY_<NAME>; defaults shown.

# development | production. Production refuses to start without an https:// public URL,
# marks cookies Secure, sends HSTS and refuses plain-HTTP requests.
RELAY_ENVIRONMENT=development

# The origin people and apps use to reach Relay. Webhook URLs are built from it.
# Leave empty in development to use whatever host the dashboard was opened on.
RELAY_PUBLIC_BASE_URL=

# SQLite by default. For Postgres: postgresql+psycopg://user:pass@host/relay (pip install psycopg[binary]).
# RELAY_DATABASE_URL=sqlite:///C:/path/to/relay/data/relay.db

# Attachment storage: local (private folder, not web-served) or s3 (any S3-compatible bucket).
RELAY_STORAGE_BACKEND=local
# RELAY_STORAGE_DIR=./data/uploads
# RELAY_S3_BUCKET=
# RELAY_S3_PREFIX=relay/
# RELAY_S3_REGION=
# RELAY_S3_ENDPOINT_URL=          # e.g. https://<account>.r2.cloudflarestorage.com for Cloudflare R2
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY=   (read by boto3)

# Lets the first account be created from a browser on another machine. Without it, first-run
# setup only works from this machine (or use: python -m app.cli create-user <name>).
RELAY_SETUP_TOKEN=

# Limits
RELAY_MAX_JSON_BYTES=262144
RELAY_MAX_UPLOAD_BYTES=26214400
RELAY_MAX_FILE_BYTES=10485760
RELAY_MAX_FILES=10
RELAY_WEBHOOK_RATE_PER_MINUTE=120
RELAY_WEBHOOK_BURST=30
RELAY_IP_RATE_PER_MINUTE=600
RELAY_IP_BURST=60
RELAY_AUTH_FAILURES_PER_MINUTE=20
RELAY_LOGIN_ATTEMPTS_PER_5MIN=10

# Retention in days (0 = keep forever). Pinned messages are never purged automatically.
RELAY_MESSAGE_RETENTION_DAYS=90
RELAY_DELIVERY_RETENTION_DAYS=30
RELAY_AUDIT_RETENTION_DAYS=365
RELAY_IDEMPOTENCY_WINDOW_HOURS=24
RELAY_SESSION_DAYS=14
